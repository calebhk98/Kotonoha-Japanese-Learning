{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup-sudachi": "bash scripts/setup-sudachi.sh",
    "setup-cache": "bash scripts/setup-cache.sh",
    "compress-cache": "bash scripts/compress-cache.sh",
    "postinstall": "bash scripts/setup-sudachi.sh || echo 'ℹ️  Sudachi setup skipped (Rust not installed). Run: npm run setup-sudachi'; bash scripts/setup-cache.sh; node scripts/print-version.js",
    "dev": "node scripts/print-version.js && tsx server.ts",
    "start": "npm run build && NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stories": "npx tsx integration/test-stories-quick.ts",
    "test:stories:full": "npx tsx integration/test-all-stories.ts",
    "add-story": "npx tsx scripts/add-story.ts",
    "transcribe": "npx tsx scripts/transcribe.ts",
    "transcribe-missing": "npx tsx scripts/transcribe-missing.ts",
    "index-copyrighted": "npx tsx scripts/index-copyrighted.ts",
    "populate-cache": "npx tsx scripts/populate-cache.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "budoux": "^0.8.2",
    "cheerio": "^1.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jmdict-wrapper": "^1.1.2",
    "JSONStream": "^1.3.5",
    "kanji-data": "^1.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.1",
    "tar": "^7.5.13",
    "tiny-segmenter": "^0.2.0",
    "unofficial-jisho-api": "^2.3.4",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
